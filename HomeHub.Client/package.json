{
  "name": "homehub-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "check:rrules": "node --experimental-strip-types scripts/check-rrules.ts",
    "check:timeline": "node --experimental-strip-types scripts/check-timeline.ts",
    "preview": "vite preview",
    "gen": "buf generate ../HomeHub.Events/Protos --template buf.gen.yaml && buf generate ../HomeHub.Tasks/Protos --template buf.gen.yaml && buf generate ../HomeHub.Notes/Protos --template buf.gen.yaml && buf generate ../HomeHub.Lists/Protos --template buf.gen.yaml && buf generate ../HomeHub.Users/Protos --template buf.gen.yaml && buf generate ../HomeHub.Integrations/Protos --template buf.gen.yaml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@nanostores/react": "2.0.1",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "date-fns": "4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "1.61.0",
    "nanostores": "1.5.5",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/js": "9.39.5",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin": "2.3.11",
    "vite": "8.3.5"
  }
}
